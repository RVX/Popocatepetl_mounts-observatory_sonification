__pycache__/
*.pyc

# local Python virtual environment (create with: python -m venv .venv) -- machine-specific, not tracked
.venv/

# raw seismic/infrasound archive (unzip the WeTransfer package here) -- large, not tracked
seed/*
!seed/.gitkeep

# REAPER autosave snapshots -- auto-generated every ~5 min while a project is
# open, regenerable, not worth tracking. The main .rpp project files stay tracked.
reaper/AutoSaves/

# MOUNTS Excel export(s) -- provided scientific data, not ours to redistribute
datasets/MOUNTS_*.xlsx

# generated outputs -- regenerate locally, don't track
datasets/ground/mseed/*
datasets/ground/plot/*
datasets/ground/sonifications/*
datasets/maps/*
datasets/satellite/raw/*
datasets/satellite/plot/*
datasets/satellite/sonifications/*
datasets/satellite/envelopes/*
!datasets/**/.gitkeep
